#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DKMS_SRC = debian/tmp/usr/src/ethercat-1.6.9

%:
	dh $@

override_dh_autoreconf:
	[ -e ChangeLog ] || touch ChangeLog
	dh_autoreconf

override_dh_auto_configure:
	# Apply packaging patches to the upstream tree before snapshotting
	# (so DKMS on the user's box sees the fixed sources too).
	for p in $$(ls -1 debian/patches/*.patch 2>/dev/null); do \
	    patch -p1 --forward --no-backup-if-mismatch < $$p || exit 1; \
	done
	# Upstream leaves $(LINUX_SYMVERS) unset in devices/Kbuild.in, which
	# collapses KBUILD_EXTRA_SYMBOLS to the build directory itself, and
	# modpost then fails with "Is a directory". Hard-wire Module.symvers,
	# and drop the bogus top-level path that never exists.
	find devices examples -name Kbuild.in -exec \
	    sed -i 's|\$$(LINUX_SYMVERS)|Module.symvers|g' {} +
	find devices examples -name Kbuild.in -exec \
	    sed -i '\|@abs_top_builddir@/Module\.symvers \\$$|d' {} +
	tar --exclude=./debian --exclude=./.git --exclude=./autom4te.cache \
	    --exclude=./debian-source-snapshot.tar \
	    -cf debian-source-snapshot.tar .
	dh_auto_configure -- \
		--enable-tty \
		--disable-kernel \
		--disable-eoe \
		--with-systemdsystemunitdir=/usr/lib/systemd/system \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var

override_dh_auto_build:
	dh_auto_build

override_dh_auto_install:
	dh_auto_install
	mkdir -p $(DKMS_SRC)
	tar -xf debian-source-snapshot.tar -C $(DKMS_SRC)
	install -D -m 0644 debian/ethercat-dkms.dkms $(DKMS_SRC)/dkms.conf
	rm -f debian/tmp/usr/lib/*/libethercat.la || true

override_dh_auto_clean:
	rm -f debian-source-snapshot.tar
	dh_auto_clean

override_dh_installinit:
	dh_installinit --name=ethercat

override_dh_auto_test:
	:
