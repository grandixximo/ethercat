#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
LINUX_DIR ?= $(firstword $(wildcard /usr/src/linux-headers-*-$(DEB_HOST_ARCH)))

DKMS_SRC = debian/tmp/usr/src/ethercat-1.5.2

%:
	dh $@

override_dh_autoreconf:
	# automake strict mode needs ChangeLog; upstream ships NEWS.md only
	[ -e ChangeLog ] || touch ChangeLog
	# relax automake: drop -Werror, add foreign (skip GNU file reqs), add subdir-objects
	sed -i 's/AM_INIT_AUTOMAKE(\[-Wall -Werror dist-bzip2\])/AM_INIT_AUTOMAKE([-Wall foreign subdir-objects dist-bzip2])/' configure.ac
	dh_autoreconf

override_dh_auto_configure:
	# snapshot pristine source for DKMS staging BEFORE configure pollutes tree
	tar --exclude=./debian --exclude=./.git --exclude=./autom4te.cache \
	    --exclude=./debian-source-snapshot.tar \
	    -cf debian-source-snapshot.tar .
	# device-driver patches in 1.5.2 only cover kernels <= 3.4;
	# trixie runs 6.12, so disable per-version drivers. generic is fine.
	# EoE disabled on both userspace and DKMS to keep the ioctl struct
	# layouts identical; any mismatch makes EC_IOR() cmd numbers diverge
	# and every ioctl returns ENOTTY.
	dh_auto_configure -- \
		--enable-tty \
		--enable-generic \
		--disable-eoe \
		--disable-8139too \
		--disable-e100 \
		--disable-e1000 \
		--disable-e1000e \
		--disable-r8169 \
		--with-linux-dir=$(LINUX_DIR) \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var

override_dh_auto_build:
	dh_auto_build

override_dh_auto_install:
	dh_auto_install
	# stage full pristine source for DKMS so autoreconf+configure succeeds
	# on the user's box regardless of per-kernel path
	mkdir -p $(DKMS_SRC)
	tar -xf debian-source-snapshot.tar -C $(DKMS_SRC)
	install -D -m 0644 debian/ethercat-dkms.dkms $(DKMS_SRC)/dkms.conf
	# remove libtool archive from main (moved to -dev only)
	rm -f debian/tmp/usr/lib/*/libethercat.la || true

override_dh_auto_clean:
	rm -f debian-source-snapshot.tar
	dh_auto_clean

override_dh_installinit:
	dh_installinit --name=ethercat

override_dh_auto_test:
	:
