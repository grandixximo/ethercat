#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
LINUX_DIR ?= $(firstword $(wildcard /usr/src/linux-headers-*-$(DEB_HOST_ARCH)))

DKMS_SRC = debian/tmp/usr/src/ethercat-1.5.2

%:
	dh $@

override_dh_autoreconf:
	# automake strict mode needs ChangeLog; upstream ships NEWS.md only
	[ -e ChangeLog ] || touch ChangeLog
	# relax automake: drop -Werror, add foreign (skip GNU file reqs), add subdir-objects
	sed -i 's/AM_INIT_AUTOMAKE(\[-Wall -Werror dist-bzip2\])/AM_INIT_AUTOMAKE([-Wall foreign subdir-objects dist-bzip2])/' configure.ac
	dh_autoreconf

override_dh_auto_configure:
	# device-driver patches in 1.5.2 only cover kernels <= 3.4;
	# trixie runs 6.12, so disable per-version drivers. generic is fine.
	dh_auto_configure -- \
		--enable-tty \
		--enable-generic \
		--disable-8139too \
		--disable-e100 \
		--disable-e1000 \
		--disable-e1000e \
		--disable-r8169 \
		--with-linux-dir=$(LINUX_DIR) \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var

override_dh_auto_build:
	dh_auto_build

override_dh_auto_install:
	dh_auto_install
	# stage kernel module sources for DKMS
	mkdir -p $(DKMS_SRC)
	cp -a \
	    Kbuild.in configure.ac \
	    bootstrap \
	    globals.h \
	    master devices include \
	    $(DKMS_SRC)/
	[ -f config.h.in ] && cp -a config.h.in $(DKMS_SRC)/ || true
	install -D -m 0644 debian/ethercat-dkms.dkms $(DKMS_SRC)/dkms.conf
	# remove libtool archive from main (moved to -dev only)
	rm -f debian/tmp/usr/lib/*/libethercat.la || true

override_dh_installinit:
	dh_installinit --name=ethercat

override_dh_auto_test:
	:
