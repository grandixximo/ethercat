PACKAGE_NAME="ethercat"
PACKAGE_VERSION="1.6.9"
AUTOINSTALL="yes"
CLEAN="rm -f config.h config.status Kbuild Makefile.kbuild"

MAKE[0]="./bootstrap && ./configure --with-linux-dir=${kernel_source_dir} \
    --enable-generic --enable-igc --enable-igb --enable-r8169 \
    --enable-genet --enable-e1000 --enable-e1000e \
    --disable-eoe --disable-userlib && \
    make -C master modules && make -C devices modules"

BUILT_MODULE_NAME[0]="ec_master"
BUILT_MODULE_LOCATION[0]="master/"
DEST_MODULE_LOCATION[0]="/updates/ethercat"

BUILT_MODULE_NAME[1]="ec_generic"
BUILT_MODULE_LOCATION[1]="devices/"
DEST_MODULE_LOCATION[1]="/updates/ethercat"

BUILT_MODULE_NAME[2]="ec_igc"
BUILT_MODULE_LOCATION[2]="devices/igc/"
DEST_MODULE_LOCATION[2]="/updates/ethercat"

BUILT_MODULE_NAME[3]="ec_igb"
BUILT_MODULE_LOCATION[3]="devices/igb/"
DEST_MODULE_LOCATION[3]="/updates/ethercat"

BUILT_MODULE_NAME[4]="ec_r8169"
BUILT_MODULE_LOCATION[4]="devices/r8169/"
DEST_MODULE_LOCATION[4]="/updates/ethercat"

BUILT_MODULE_NAME[5]="ec_genet"
BUILT_MODULE_LOCATION[5]="devices/genet/"
DEST_MODULE_LOCATION[5]="/updates/ethercat"

BUILT_MODULE_NAME[6]="ec_e1000"
BUILT_MODULE_LOCATION[6]="devices/e1000/"
DEST_MODULE_LOCATION[6]="/updates/ethercat"

BUILT_MODULE_NAME[7]="ec_e1000e"
BUILT_MODULE_LOCATION[7]="devices/e1000e/"
DEST_MODULE_LOCATION[7]="/updates/ethercat"
